# Static Analysis Engine Configuration

# Server
HOST=0.0.0.0
PORT=8000

# File upload limits
MAX_FILE_SIZE_MB=10
MAX_ZIP_SIZE_MB=50

# SonarQube (optional)
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=your_sonarqube_token_here
SONARQUBE_ENABLED=false

# Results storage
RESULTS_DIR=results

# Analysis timeout (seconds)
ANALYSIS_TIMEOUT=300
